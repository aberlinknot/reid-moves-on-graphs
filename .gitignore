# Python bytecode and cache
__pycache__/
*.pyc

# Virtual environments
.env/
.venv/
venv/

# IDE/editor config files
.idea/
.vscode/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# macOS system files
.DS_Store

# Build artifacts and package metadata
build/
dist/
.eggs/
*.egg-info/

# Generated result images (keep directory structure)
results/images/*
!results/images/.gitkeep
!results/images/nontrivial_brackets/
!results/images/nontrivial_brackets/**

# Generated experiment logs (keep directory structure)
results/logs/*
!results/logs/.gitkeep

# LaTeX build artifacts in articles/ (keep only .tex and .pdf)
articles/**/*.aux
articles/**/*.fdb_latexmk
articles/**/*.fls
articles/**/*.log
articles/**/*.synctex.gz
articles/**/*.out
articles/**/*.toc
articles/**/*.bbl
articles/**/*.blg

# Temporary / unsure files – not ready to delete permanently
junk/

# Random move experiment logs (keep directory structure, add manually)
scripts/random_moves/*/logs/*
!scripts/random_moves/*/logs/.gitkeep
